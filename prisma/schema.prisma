// =====================================================================
// LabourSeva: complete database schema (MySQL, Prisma)
// Conventions
//  - Money is stored as BigInt PAISE (1 rupee = 100 paise). Never floats.
//  - *Enc columns hold AES-256-GCM ciphertext ("v<keyVersion>:<iv>:<tag>:<data>").
//  - *Hash columns hold HMAC-SHA256 blind indexes (hex, 64 chars) for lookups.
//  - Audit-style "...ById" columns on low-risk tables are plain indexed
//    CHAR(36) with NO foreign key on purpose, so history survives user closure.
//  - audit_logs must be INSERT/SELECT only for the app DB user (see notes).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7+: the connection URL lives in prisma.config.ts, not here.
// Prisma 6 or older: add   url = env("DATABASE_URL")   inside this block.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  RETAILER
  DISTRIBUTOR
  AGENT
  EMPLOYEE
  ADMIN
}

enum Portal {
  CUSTOMER
  GUEST
  RETAILER
  DISTRIBUTOR
  AGENT
  EMPLOYEE
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_KYC
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  FLAGGED
  CLOSED
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum Language {
  EN
  TA
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RECOVERY
  GUEST_CHECKOUT
  GUEST_TRACK
  STEP_UP
}

enum ApplicantType {
  CUSTOMER
  GUEST
  ASSISTED_RETAILER
  ASSISTED_AGENT
}

enum ApplicationStatus {
  DRAFT
  PENDING_PAYMENT
  PAID_PENDING_VERIFICATION
  IN_REVIEW
  RETURNED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReviewDecision {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum PaymentMode {
  GATEWAY
  WALLET
}

enum PaymentProvider {
  RAZORPAY
  PAYU
}

enum PaymentPurpose {
  APPLICATION_FEE
  WALLET_TOPUP
  REGISTRATION_FEE
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  FAILED
}

enum WalletStatus {
  ACTIVE
  FROZEN
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerRefType {
  PAYMENT_TOPUP
  APPLICATION_FEE
  COMMISSION
  REFERRAL_REWARD
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  PAYOUT_HOLD
  PAYOUT_RELEASE
}

enum TransferStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
}

enum CommissionStatus {
  ACCRUED
  CREDITED
  REVERSED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum DocumentKind {
  IDENTITY
  APPLICATION_UPLOAD
  KYC
  CERTIFICATE_OUTPUT
  RECEIPT
  TICKET_ATTACHMENT
  PARTNER_AGREEMENT
  PROFILE_PHOTO
}

enum DocumentStatus {
  ACTIVE
  DELETED
  PURGED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  SKIPPED
}

enum TokenPurpose {
  VIEW
  DOWNLOAD
}

enum TicketType {
  FEEDBACK
  GRIEVANCE
  CONTACT
  HELPDESK
  ADVERTISE
  CAREERS
  PARTNER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CITIZEN
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageAuthorType {
  CITIZEN
  STAFF
  SYSTEM
}

enum Channel {
  SMS
  EMAIL
  INAPP
  WEB
}

enum IamAction {
  ACTIVATE
  SUSPEND
  REACTIVATE
  FLAG
  REVOKE_SESSIONS
  GRANT_ACCESS
