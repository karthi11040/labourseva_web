# ──────────────────────────────────────────────
# LabourSeva — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Database
DATABASE_URL="mysql://user:password@127.0.0.1:3306/labourseva"
STAGING_DATABASE_URL="mysql://user:password@127.0.0.1:3306/labourseva_staging"

# Per-portal session secrets (generate with: openssl rand -base64 32)
SESSION_SECRET_CUST=""
SESSION_SECRET_GUEST=""
SESSION_SECRET_ADMIN=""
SESSION_SECRET_DIST=""
SESSION_SECRET_RET=""
SESSION_SECRET_EMP=""

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION="1"
HMAC_BLIND_INDEX_KEY=""

# CSRF
CSRF_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""   # separate from key secret — used ONLY for webhook verification

# SMS — My Dreams Technology
SMS_API_URL="https://..."    # must be https — rotate key if using old http endpoint
SMS_API_KEY=""               # rotate immediately if previously exposed
SMS_SENDER_ID="MDTDMO"
SMS_APP_NAME="labourseva.com"
SMS_OTP_TEMPLATE_ID=""
SMS_PAYMENT_TEMPLATE_ID=""
SMS_STATUS_TEMPLATE_ID=""
SMS_COMPLETION_TEMPLATE_ID=""

# Email (SES or Brevo SMTP)
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM="no-reply@labourseva.com"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   # public — safe to expose in browser
CLOUDFLARE_TURNSTILE_SECRET=""       # server-side only

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
