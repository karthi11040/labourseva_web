# ──────────────────────────────────────────────
# LabourSeva — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Database
DATABASE_URL="mysql://user:password@127.0.0.1:3306/labourseva"
STAGING_DATABASE_URL="mysql://user:password@127.0.0.1:3306/labourseva_staging"

# Per-portal session secrets (generate with: openssl rand -base64 32)
SESSION_SECRET_CUST=""
SESSION_SECRET_GUEST=""
SESSION_SECRET_ADMIN=""
SESSION_SECRET_DIST=""
SESSION_SECRET_RET=""
SESSION_SECRET_EMP=""
# Staff HMAC cookie (falls back to SESSION_SECRET_EMP / ADMIN_SESSION_SECRET when unset)
STAFF_SESSION_SECRET=""

# Super-admin login (keep these server-side; never prefix with NEXT_PUBLIC_)
ADMIN_EMAIL="admin@example.gov.in"
ADMIN_PASSWORD="replace-with-a-long-random-password"
NEXT_PUBLIC_GOOGLE_ADSENSE_ID="ca-pub-3642883735997037"

# Cap CAPTCHA (Self-Hosted Privacy-First Bot Protection: https://github.com/tiagozip/cap)
# Server-side verification connection (Never expose CAP_SECRET_KEY in frontend)
CAP_SERVER_URL="http://127.0.0.1:3002"
CAP_SITE_KEY="cap_site_labourseva_prod"
CAP_SECRET_KEY="cap_sec_replace_with_server_secret"
# Client-side endpoint for <cap-widget>
NEXT_PUBLIC_CAP_ENDPOINT="http://127.0.0.1:3002/cap_site_labourseva_prod/"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION="1"
HMAC_BLIND_INDEX_KEY=""

# CSRF
CSRF_SECRET=""

# Security strictness (optional, recommended AFTER all secrets are set in prod):
# STRICT_SECRETS=true aborts boot if any required session secret is missing,
# instead of falling back to a development constant.
# Before enabling: node scripts/audit_security_env.mjs
STRICT_SECRETS="false"

# CAPTCHA signing (falls back to SESSION_SECRET_ADMIN / ENCRYPTION_KEY when unset)
CAPTCHA_SECRET=""

# Razorpay
RAZORPAY_ENV="live"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""
RAZORPAY_API_BASE="https://api.razorpay.com/v1"
RAZORPAY_DISABLE_SSL_VERIFY="false"
RAZORPAY_WEBHOOK_SECRET=""   # separate from key secret — used ONLY for webhook verification

# SMS — My Dreams Technology
SMS_API_URL="http://app.mydreamstechnology.in/vb/apikey.php"
SMS_API_KEY=""
SMS_SENDER_ID="MDTDMO"
SMS_APP_NAME="labourseva.com"
SMS_TEMPLATE="Dear {otp}, Your OTP for login to {app_name}. Valid for 30 minutes. Please do not share this OTP. Regards, My Dreams Technology Team"

# Email SMTP (Gmail / Custom SMTP)
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="LabourSeva"
EMAIL_REPLY_TO=""
EMAIL_DEBUG="false"
EMAIL_UNSUBSCRIBE_BASE_URL="https://labourseva.com/unsubscribe"
EMAIL_UNSUBSCRIBE_EMAIL=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   # public — safe to expose in browser
CLOUDFLARE_TURNSTILE_SECRET=""       # server-side only

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
